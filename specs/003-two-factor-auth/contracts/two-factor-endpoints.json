{
  "openapi": "3.0.3",
  "info": {
    "title": "Two-Factor Authentication Management API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/Users/me": {
      "get": {
        "summary": "Get current user profile and 2FA status",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "User profile retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "userId": { "type": "string", "format": "uuid" },
                    "email": { "type": "string" },
                    "role": { "type": "string" },
                    "isTwoFactorEnabled": { "type": "boolean" }
                  },
                  "required": ["userId", "email", "role", "isTwoFactorEnabled"]
                }
              }
            }
          }
        }
      }
    },
    "/api/Auth/2fa/enable": {
      "post": {
        "summary": "Initiate 2FA setup",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "2FA setup initiated with secret and QR code URI",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "secret": { "type": "string" },
                    "qrCodeUri": { "type": "string" }
                  },
                  "required": ["secret", "qrCodeUri"]
                }
              }
            }
          }
        }
      }
    },
    "/api/Auth/2fa/verify": {
      "post": {
        "summary": "Verify TOTP code to activate 2FA",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": { "type": "string", "pattern": "^[0-9]{6}$" }
                },
                "required": ["code"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "2FA successfully activated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid code"
          }
        }
      }
    },
    "/api/Auth/2fa/disable": {
      "post": {
        "summary": "Disable 2FA with valid TOTP code",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "code": { "type": "string", "pattern": "^[0-9]{6}$" }
                },
                "required": ["code"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "2FA successfully disabled",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid code"
          }
        }
      }
    }
  }
}
