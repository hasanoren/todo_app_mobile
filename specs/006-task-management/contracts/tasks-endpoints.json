{
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/TodoItems",
      "auth": "Required",
      "description": "Create a new task",
      "request": {
        "title": "string (required, max 200)",
        "description": "string? (optional)",
        "dueDate": "ISO 8601 UTC string? (optional)",
        "priority": "integer (0..3, default 1)",
        "todoListId": "uuid? (optional)"
      },
      "response": {
        "status": 201,
        "body": "TodoItemResponse"
      }
    },
    {
      "method": "GET",
      "path": "/api/TodoItems",
      "auth": "Required",
      "description": "Get paginated tasks with filter/search/sort",
      "queryParams": {
        "filterType": "int (0..3, default 0)",
        "search": "string? (optional)",
        "status": "int? (0..1)",
        "priority": "int? (0..3)",
        "todoListId": "uuid?",
        "dueDateFrom": "ISO 8601 UTC string?",
        "dueDateTo": "ISO 8601 UTC string?",
        "sortBy": "string? (createdAt, dueDate, title, priority, default createdAt)",
        "sortOrder": "string? (asc, desc, default desc)",
        "page": "int (default 1)",
        "pageSize": "int (default 20, max 100)"
      },
      "response": {
        "status": 200,
        "body": "PaginatedResponse<TodoItemResponse>"
      }
    },
    {
      "method": "GET",
      "path": "/api/TodoItems/{id}",
      "auth": "Required",
      "description": "Get single task detail with subtasks, tags, shared users",
      "response": {
        "status": 200,
        "body": "TodoItemResponse"
      }
    },
    {
      "method": "PUT",
      "path": "/api/TodoItems/{id}",
      "auth": "Required (owner only)",
      "description": "Update task",
      "request": {
        "title": "string (required, max 200)",
        "description": "string?",
        "dueDate": "ISO 8601 UTC string?",
        "priority": "integer (0..3)",
        "todoListId": "uuid?"
      },
      "response": {
        "status": 200,
        "body": "TodoItemResponse"
      }
    },
    {
      "method": "PATCH",
      "path": "/api/TodoItems/{id}/complete",
      "auth": "Required (owner only)",
      "description": "Toggle task between Open and Completed",
      "response": {
        "status": 200,
        "body": "TodoItemResponse"
      }
    },
    {
      "method": "DELETE",
      "path": "/api/TodoItems/{id}",
      "auth": "Required (owner only)",
      "description": "Soft delete task (move to trash)",
      "response": {
        "status": 204
      }
    }
  ]
}
