{
  "openapi": "3.0.0",
  "info": {
    "title": "Trash / Recycle Bin API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/TodoItems/trash": {
      "get": {
        "summary": "Get paginated soft-deleted tasks for current user",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of deleted tasks",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedTodoItemsResponse"
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/TodoItems/{id}/restore": {
      "post": {
        "summary": "Restore a soft-deleted task from trash",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task restored successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TodoItemResponse"
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Task not found in trash or not owned" }
        }
      }
    },
    "/api/TodoItems/{id}/permanent": {
      "delete": {
        "summary": "Permanently destroy a soft-deleted task from trash",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Task permanently destroyed"
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Task not found in trash or not owned" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TodoItemResponse": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "status": { "type": "string" },
          "priority": { "type": "integer" },
          "dueDate": { "type": "string", "format": "date-time", "nullable": true },
          "isCompleted": { "type": "boolean" },
          "isDeleted": { "type": "boolean" },
          "isOwner": { "type": "boolean" },
          "todoListId": { "type": "string", "format": "uuid", "nullable": true },
          "todoListName": { "type": "string", "nullable": true },
          "createdAt": { "type": "string", "format": "date-time" },
          "deletedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "PaginatedTodoItemsResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/TodoItemResponse" }
          },
          "totalCount": { "type": "integer" },
          "page": { "type": "integer" },
          "pageSize": { "type": "integer" },
          "totalPages": { "type": "integer" }
        }
      }
    }
  }
}

