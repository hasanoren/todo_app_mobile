{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Password Recovery API Contracts",
  "description": "JSON Schema contracts for FEAT-02: Password Recovery & Deep Linking endpoints",
  "endpoints": {
    "forgotPassword": {
      "method": "POST",
      "path": "/api/Auth/forgot-password",
      "authRequired": false,
      "rateLimit": "2/minute",
      "request": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          }
        },
        "additionalProperties": false
      },
      "responses": {
        "200": {
          "description": "Reset link dispatched if user exists (User enumeration prevention).",
          "type": "object",
          "required": ["message"],
          "properties": {
            "message": {
              "type": "string",
              "example": "If this email is registered, a password reset link has been sent."
            }
          }
        },
        "400": {
          "description": "Validation error (invalid email format)",
          "$ref": "#/definitions/ProblemDetails"
        },
        "429": {
          "description": "Rate limit exceeded (more than 2 requests per minute)",
          "$ref": "#/definitions/ProblemDetails"
        }
      }
    },
    "resetPassword": {
      "method": "POST",
      "path": "/api/Auth/reset-password",
      "authRequired": false,
      "request": {
        "type": "object",
        "required": ["token", "newPassword"],
        "properties": {
          "token": {
            "type": "string",
            "description": "URL-decoded reset token extracted from deep link query parameter"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8,
            "example": "NewPassword123!"
          }
        },
        "additionalProperties": false
      },
      "responses": {
        "200": {
          "description": "Password successfully updated.",
          "type": "object",
          "required": ["message"],
          "properties": {
            "message": {
              "type": "string",
              "example": "Password has been successfully changed."
            }
          }
        },
        "400": {
          "description": "Invalid/expired token or password validation failure",
          "$ref": "#/definitions/ProblemDetails"
        }
      }
    }
  },
  "definitions": {
    "ProblemDetails": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "title": { "type": "string" },
        "status": { "type": "integer" },
        "detail": { "type": "string" },
        "errors": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
